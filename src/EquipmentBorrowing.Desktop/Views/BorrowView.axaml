<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:domain="using:EquipmentBorrowing.Domain.Entities"
    xmlns:converters="using:EquipmentBorrowing.Desktop.Converters"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    x:Class="EquipmentBorrowing.Desktop.Views.BorrowView"
    x:DataType="vm:BorrowViewModel">

	<UserControl.Resources>

		<converters:EquipmentDisplayConverter
            x:Key="EquipmentDisplayConverter"/>

	</UserControl.Resources>

	<Grid
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
        Margin="30"
        RowSpacing="16">

		<!-- TITLE -->
		<StackPanel
			Grid.Row="0"
			Orientation="Horizontal"
			Spacing="15">

			<TextBlock
				Text="Borrow Equipment"
				FontSize="28"
				FontWeight="Bold"/>

			<Button
				Content="Refresh Data"
				Command="{Binding LoadCommand}"
				VerticalAlignment="Center"/>

		</StackPanel>


		<!-- STUDENT -->
		<StackPanel
            Grid.Row="1"
            Spacing="6">

			<TextBlock
                Text="Student"
                FontWeight="Bold"/>

			<ComboBox
                ItemsSource="{Binding Students}"
                SelectedItem="{Binding SelectedStudent}"
                HorizontalAlignment="Stretch">

				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock
                            Text="{Binding StudentName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</StackPanel>

<!-- EQUIPMENT -->
<StackPanel
    Grid.Row="2"
    Spacing="6">

    <TextBlock
        Text="Equipment"
        FontWeight="Bold"/>

    <ComboBox
        ItemsSource="{Binding Equipment}"
        SelectedItem="{Binding SelectedEquipment}"
        HorizontalAlignment="Stretch">


        <ComboBox.ItemTemplate>
            <DataTemplate
                x:DataType="domain:Equipment">

                <TextBlock
                    Text="{Binding Converter={StaticResource EquipmentDisplayConverter}}"/>

            </DataTemplate>
        </ComboBox.ItemTemplate>

    </ComboBox>

</StackPanel>

		<!-- EXPECTED RETURN DATE -->
		<StackPanel
            Grid.Row="3"
            Spacing="6">

			<TextBlock
                Text="Expected Return Date"
                FontWeight="Bold"/>

			<CalendarDatePicker
                SelectedDate="{Binding ExpectedReturnDate}"
                PlaceholderText="Select expected return date"
                DisplayDateStart="{x:Static sys:DateTime.Today}"
                HorizontalAlignment="Stretch"/>

		</StackPanel>


		<!-- BORROW BUTTON -->
		<Button
            Grid.Row="4"
            Content="Borrow Equipment"
            Command="{Binding BorrowEquipmentCommand}"
            HorizontalAlignment="Left"
            Padding="20,10"/>


		<!-- RESULT -->
		<Border
            Grid.Row="5"
            Margin="0,10,0,0"
            Padding="15">

			<TextBlock
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap"/>

		</Border>

	</Grid>

</UserControl>