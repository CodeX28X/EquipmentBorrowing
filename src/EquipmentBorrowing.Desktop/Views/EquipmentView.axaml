
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:domain="using:EquipmentBorrowing.Domain.Entities"
    xmlns:converters="using:EquipmentBorrowing.Desktop.Converters"
    x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
    x:DataType="vm:EquipmentViewModel">

    <UserControl.Resources>
        <converters:AvailabilityConverter x:Key="AvailabilityConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="20"
          RowSpacing="14">

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Equipment Management"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock
                Text="Register new equipment, update existing information, and check availability."
                TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="1.1*,1*"
              ColumnSpacing="18">

            <!-- Equipment list -->
            <Border Grid.Column="0"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">


				<Grid RowDefinitions="Auto,Auto,Auto,*"
					  RowSpacing="10">

					<!-- Equipment list heading and refresh -->
					<Grid Grid.Row="0"
						  ColumnDefinitions="*,Auto">

						<TextBlock Text="Registered equipment"
								   FontWeight="SemiBold"
								   VerticalAlignment="Center"/>

						<Button Grid.Column="1"
								Content="Refresh"
								Command="{Binding LoadEquipmentCommand}"
								IsEnabled="{Binding !IsBusy}"/>
					</Grid>

					<!-- UC-02: Availability filter -->
					<CheckBox Grid.Row="1"
							  Content="Available only"
							  IsChecked="{Binding ShowAvailableOnly, Mode=TwoWay}"
							  IsEnabled="{Binding !IsBusy}"/>

					<!-- Filter result summary / empty state -->
					<TextBlock Grid.Row="2"
							   Text="{Binding FilterStatusMessage}"
							   FontSize="12"
							   TextWrapping="Wrap"/>

					<!-- Filtered equipment catalog -->
					<ListBox Grid.Row="3"
							 ItemsSource="{Binding FilteredEquipment}"
							 SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}">

						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="domain:Equipment">

								<StackPanel Margin="4"
											Spacing="3">

									<TextBlock
										Text="{Binding EquipmentName}"
										FontWeight="SemiBold"/>

									<TextBlock
										Text="{Binding EquipmentIdentifier}"
										FontSize="12"/>

									<TextBlock
										Text="{Binding IsAvailable,
                            Converter={StaticResource AvailabilityConverter}}"
										FontSize="12"/>

								</StackPanel>

							</DataTemplate>
						</ListBox.ItemTemplate>

					</ListBox>
				</Grid>
			</Border>

            <!-- Equipment registration/edit form -->
            <Border Grid.Column="1"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <ScrollViewer>
                    <StackPanel Spacing="10">

                        <TextBlock Text="{Binding FormTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Equipment identifier *"/>

                        <TextBox
                            Text="{Binding EquipmentIdentifier, Mode=TwoWay}"
                            PlaceholderText="e.g. LAPTOP-005"/>

                        <TextBlock Text="Equipment name *"/>

                        <TextBox
                            Text="{Binding EquipmentName, Mode=TwoWay}"
                            PlaceholderText="e.g. Dell Laptop"/>

                        <TextBlock Text="Description (optional)"/>

                        <TextBox
                            Text="{Binding Description, Mode=TwoWay}"
                            PlaceholderText="Enter equipment description"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="75"/>

                        <TextBlock
                            Text="{Binding SelectedEquipment.IsAvailable,
                                StringFormat='Currently available: {0}'}"
                            IsVisible="{Binding IsEditing}"/>

                        <Button
                            Content="Save equipment"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding SaveCommand}"/>

                        <Button
                            Content="New equipment"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding NewEquipmentCommand}"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"/>

    </Grid>
</UserControl>
