<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="EquipmentBorrowing.Desktop.MainWindow"
    Title="Equipment Borrowing System"
    Width="1100"
    Height="720"
    MinWidth="850"
    MinHeight="550">

	<DockPanel>

		<!-- Main navigation -->
		<Border
            DockPanel.Dock="Top"
            Padding="15"
            BorderThickness="0,0,0,1"
            BorderBrush="#CCCCCC">

			<StackPanel
                Orientation="Horizontal"
                Spacing="10">

				<TextBlock
                    Text="Equipment Borrowing System"
                    FontSize="20"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0"/>

				<Button
                    Content="Equipment"
                    Click="EquipmentButton_Click"/>

				<Button
                    Content="Borrow Equipment"
                    Click="BorrowButton_Click"/>

				<Button
                    Content="Active Borrowings"
                    Click="ActiveBorrowingsButton_Click"/>

				<!-- UC-12 to UC-14 -->
				<Button
                    Content="Students"
                    Click="StudentsButton_Click"/>

			</StackPanel>
		</Border>

		<!-- Active view -->
		<ContentControl
            x:Name="ContentArea"/>

	</DockPanel>
</Window>
