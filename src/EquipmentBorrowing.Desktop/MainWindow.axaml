<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="EquipmentBorrowing.Desktop.MainWindow"
    Title="Equipment Borrowing System"
    Width="1000"
    Height="700">

	<DockPanel>

		<!-- Navigation -->
		<Border
            DockPanel.Dock="Top"
            Padding="15"
            BorderThickness="0,0,0,1">

			<StackPanel
                Orientation="Horizontal"
                Spacing="10">

				<TextBlock
                    Text="Equipment Borrowing System"
                    FontSize="20"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0" />

				<Button
                    Content="Equipment"
                    Click="EquipmentButton_Click" />

				<Button
                    Content="Borrow Equipment"
                    Click="BorrowButton_Click" />

				<Button
                    Content="Active Borrowings"
                    Click="ActiveBorrowingsButton_Click" />

			</StackPanel>

		</Border>

		<!-- Current View -->
		<ContentControl
            x:Name="ContentArea" />

	</DockPanel>

</Window>